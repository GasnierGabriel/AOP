# Copier en .env sur le serveur (jamais commité). Générer les secrets avec : openssl rand -hex 32
# HTTPS : SITE_ADDRESS = nom de domaine pointant vers le serveur (certificat Let's Encrypt automatique)
SITE_ADDRESS=erp.arece.eu
PUBLIC_URL=https://erp.arece.eu
# Ancienne adresse redirigée vers PUBLIC_URL (facultatif)
REDIRECT_FROM=http://<ip-du-serveur>
POSTGRES_PASSWORD=
JWT_SECRET=

# SSO Google Workspace (facultatif). Client OAuth « Application Web » dans la console GCP,
# URI de redirection autorisée : <PUBLIC_URL>/api/auth/google/callback (HTTPS + nom de domaine obligatoires)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=arece.eu

# Envoi de mails (mot de passe oublié). Vide = fonction désactivée.
# Option A (recommandée) : relais SMTP Google Workspace autorisé par l'IP du serveur, sans mot de passe
#   Console d'admin > Applications > Google Workspace > Gmail > Routage > Service de relais SMTP
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B : compte Google dédié + mot de passe d'application (validation en 2 étapes obligatoire)
#   SMTP_HOST=smtp.gmail.com  SMTP_USER=erp@arece.eu  SMTP_PASS=<mot de passe d'application>
MAIL_FROM=erp@arece.eu
MAIL_FROM_NAME=ERP ARECE

# Galerie photos (facultatif : vide = galerie désactivée). Mise en place pas à pas : README, section « Galerie ».
# ID du Drive partagé « ARECE – Photos » (dernière partie de son adresse : drive.google.com/drive/folders/<ID>)
GALLERY_SHARED_DRIVE_ID=
GALLERY_SYNC_INTERVAL_MINUTES=10
# Facultatif : secret des liens d'images signés (par défaut, dérivé de JWT_SECRET). openssl rand -hex 32
GALLERY_URL_SIGNING_SECRET=
# La clé JSON du compte de service se dépose dans ~/arece/secrets/galerie-drive.json (chmod 600), pas ici.
