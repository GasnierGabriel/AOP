# Copier en .env sur le serveur (jamais commité). Générer les secrets avec : openssl rand -hex 32
# HTTPS : SITE_ADDRESS = nom de domaine pointant vers le serveur (certificat Let's Encrypt automatique)
SITE_ADDRESS=erp.arece.eu
PUBLIC_URL=https://erp.arece.eu
# Ancienne adresse redirigée vers PUBLIC_URL (facultatif)
REDIRECT_FROM=http://<ip-du-serveur>
POSTGRES_PASSWORD=
JWT_SECRET=

# SSO Google Workspace (facultatif). Client OAuth « Application Web » dans la console GCP,
# URI de redirection autorisée : <PUBLIC_URL>/api/auth/google/callback (HTTPS + nom de domaine obligatoires)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=arece.eu
