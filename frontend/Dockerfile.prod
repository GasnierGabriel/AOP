# Build React puis service statique + reverse proxy /api par Caddy
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ENV REACT_APP_API_URL=/api
# Pas de script en ligne dans index.html (politique CSP stricte) ni de cartes de sources publiées
ENV INLINE_RUNTIME_CHUNK=false GENERATE_SOURCEMAP=false
RUN npm run build

FROM caddy:2-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/build /srv
