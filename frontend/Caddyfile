{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Une fois venu en HTTPS, le navigateur n'utilise plus que HTTPS pour ce domaine (ignoré en HTTP)
		Strict-Transport-Security "max-age=31536000"
		# Seuls les scripts, styles, polices et appels de l'ERP lui-même sont autorisés (images du wiki : tout lien https).
		# Styles en ligne permis : attributs style de React et diagrammes Mermaid.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Aucune fonction sensible du navigateur n'est utilisée par l'ERP
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
		-X-Powered-By
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	# Serveur MCP (assistants IA) et routes OAuth standard servies par le backend
	@mcp path /mcp /authorize /token /register /revoke /.well-known/*
	handle @mcp {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		# Assets CRA hashés : cache long ; le reste (index.html des routes SPA) : revalidé à chaque fois
		@static path /static/*
		@notStatic not path /static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		header @notStatic Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Ancienne adresse (ex : http://<IP>) redirigée vers le site. Sans REDIRECT_FROM,
# ce bloc écoute un port interne inutilisé et n'a aucun effet.
{$REDIRECT_FROM} {
	redir {$PUBLIC_URL}{uri} permanent
}
