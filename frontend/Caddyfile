{$SITE_ADDRESS} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Une fois venu en HTTPS, le navigateur n'utilise plus que HTTPS pour ce domaine (ignoré en HTTP)
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	# Serveur MCP (assistants IA) et routes OAuth standard servies par le backend
	@mcp path /mcp /authorize /token /register /revoke /.well-known/*
	handle @mcp {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		# Assets CRA hashés : cache long ; le reste (index.html des routes SPA) : revalidé à chaque fois
		@static path /static/*
		@notStatic not path /static/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		header @notStatic Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Ancienne adresse (ex : http://<IP>) redirigée vers le site. Sans REDIRECT_FROM,
# ce bloc écoute un port interne inutilisé et n'a aucun effet.
{$REDIRECT_FROM} {
	redir {$PUBLIC_URL}{uri} permanent
}
